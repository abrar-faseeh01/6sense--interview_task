# Database connection string (REQUIRED)
# The server will NOT start if this is not set.
# Use your local MongoDB: mongodb://localhost:27017/devsocial
# Or MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devsocial
MONGODB_URI=mongodb://localhost:27017/devsocial

# Port for the backend API (Default: 5000)
PORT=5000

# Secret key for JWT signing (Required for production, defaults to 'supersecret' in dev)
JWT_SECRET=your_super_secret_jwt_key

